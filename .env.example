# compose 部署变量模板：cp .env.example .env 后按需填写（compose 自动读取同目录 .env）

# 必填
POSTGRES_PASSWORD=                # openssl rand -hex 24

# 强烈建议（生产必填）
ADMIN_KEY=                        # openssl rand -hex 64；不填则服务随机生成且不可取回
STORAGE_SECRET_MASTER_KEY=        # openssl rand -hex 32；不填则池凭据明文落库

# 可选
VITE_BASE_API=http://127.0.0.1:8081  # WebUI 构建期注入的 API 域名
CORS_ALLOWED_ORIGINS=                 # 逗号分隔的 Origin 白名单；留空 = 放行全部（仅内网）
MAX_UPLOAD_BYTES=2147483648           # 上传请求体上限（字节）
PUBLIC_RATE_LIMIT=120                 # 公开端点每 IP 每分钟限流
TRUST_X_FORWARDED_FOR=0               # 挂可信反代后置 1，限流按 XFF 计客户端 IP